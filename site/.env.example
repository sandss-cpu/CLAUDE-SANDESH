# Batoma public website (site/). Copy to .env for local use; on Render these are set on
# the bato-site service.

# The read-only batoma_site role (created by `npm run db:site-role` in backend/). Never the
# owner: the role's grants and row-level security are what keep drafts, unverified
# listings and private columns off the website.
DATABASE_URL="postgresql://batoma_site:CHANGE_ME@localhost:5432/batoma_phase3?schema=public"

# Shared with the API (same value as its SITE_API_KEY): forms are forwarded with it and
# the API's cache purges are signed with it. At least 32 characters in production.
SITE_API_KEY=

# Where the API, the app and this site live.
API_URL=http://localhost:3000/api/v1
APP_URL=http://localhost:5173
SITE_URL=http://localhost:4000
PORT=4000

# Optional: salt for visit codes (defaults to SITE_API_KEY); seconds a page is kept in
# memory before it is drawn again (default 300).
# SITE_EVENT_SALT=
# PAGE_TTL=300

# Tests only (npm test): the owner connection, used to set up and remove fixtures.
# OWNER_DATABASE_URL="postgresql://travel:travel@localhost:5432/batoma_phase3?schema=public"
