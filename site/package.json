{
  "name": "batoma-site",
  "version": "1.0.0",
  "private": true,
  "description": "Batoma's public website: the magazine, trips and partners, rendered on the server.",
  "scripts": {
    "prepare-files": "node scripts/prepare.mjs",
    "build": "node scripts/prepare.mjs && prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node --env-file=.env dist/src/server.js",
    "test": "npm run build && node --env-file-if-exists=.env --test --test-concurrency=1 'dist/test/*.test.js'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "prisma": "5.22.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true
  }
}
