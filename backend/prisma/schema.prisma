// =====================================================================
//  QR TRAVEL MAGAZINE & TOURISM PLATFORM  —  Prisma schema
//  PostgreSQL. Geospatial columns use plain lat/lng doubles plus an
//  optional PostGIS geography column added via raw migration SQL.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- ENUMS -------------------------

enum Role {
  READER
  CONTRIBUTOR
  BUSINESS_OWNER
  OPERATOR_ADMIN
  MODERATOR
  EDITOR
  ADMIN
}

enum Language {
  NE
  EN
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum TargetType {
  ARTICLE
  POST
  COMMENT
  BUSINESS
  REVIEW
  USER
  AD
  BUS_REVIEW
  OPERATOR
}

enum ReactionType {
  LIKE
  LOVE
  HELPFUL
  WOW
}

enum BusinessCategory {
  HOTEL
  HOMESTAY
  LODGE
  RESTAURANT
  CAFE
  TREKKING_AGENCY
  ADVENTURE
  PARAGLIDING
  RENTAL
  GUIDE
  HANDICRAFT
  TOUR_OPERATOR
  TRANSPORT
}

enum BusinessTier {
  FREE
  VERIFIED
  FEATURED
  PREMIUM
}

enum LeadType {
  PROFILE_VIEW
  CALL
  WHATSAPP
  VIBER
  DIRECTIONS
  WEBSITE
  ENQUIRY
  COUPON_VIEW
}

enum PlaceType {
  BUS_STOP
  TOILET
  ATM
  PHARMACY
  HOSPITAL
  POLICE
  FUEL
  DRINKING_WATER
  VIEWPOINT
  TEAHOUSE
  TEMPLE
  MONASTERY
  MUSEUM
  TREK_START
  CAMPSITE
  OTHER
}

enum BudgetStyle {
  BACKPACKER
  STANDARD
  COMFORT
}

enum PostTemplate {
  FREEFORM
  MY_TREK
  A_DAY_IN
  WHERE_I_ATE
  GETTING_THERE
  WHAT_IT_COST
}

enum ReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  ILLEGAL
  SEXUAL_CONTENT
  COPYRIGHT
  UNSAFE_BUSINESS
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ModerationAct {
  APPROVE
  REJECT
  HIDE
  DELETE
  WARN_USER
  SUSPEND_USER
  UNSUSPEND_USER
  CHANGE_ROLE
  RESET_MFA
  CREATE
  UPDATE
  PAUSE
  RESUME
}

// ------------------------- IDENTITY -------------------------

model User {
  id            String   @id @default(uuid())
  phone         String?  @unique
  email         String?  @unique
  name          String
  avatarUrl     String?
  bio           String?
  homeDistrict  String?
  language      Language @default(NE)
  role          Role     @default(READER)
  isPhoneVerified Boolean @default(false)
  /// argon2id. Null for phone-only accounts.
  passwordHash    String?
  /// Email sign-in is refused until the owner has clicked the emailed link.
  emailVerifiedAt DateTime?
  isSuspended   Boolean  @default(false)
  suspendedUntil DateTime?
  /// TOTP second factor. Mandatory for privileged roles — an SMS code alone
  /// is not an acceptable gate on platform administration (SIM-swap risk).
  totpSecret     String?
  totpConfirmedAt DateTime?
  // privacy
  hideExactLocation Boolean @default(true)
  publishDelayHours Int     @default(0) // solo-traveller safety: delay geo publish
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  articles          Article[]         @relation("ArticleAuthor")
  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  postVotes         PostVote[]
  bookmarks         Bookmark[]
  itineraries       Itinerary[]
  reviews           Review[]
  redemptions       CouponRedemption[]
  refreshTokens     RefreshToken[]
  emailTokens       EmailToken[]
  ownedBusinesses   Business[]        @relation("BusinessOwner")
  adsCreated        Advertisement[]   @relation("AdCreator")
  reportsMade       Report[]          @relation("Reporter")
  moderationActions ModerationEntry[] @relation("Moderator")
  emergencyContacts EmergencyContact[]
  sosEvents         SosEvent[]
  following         Follow[]          @relation("Follower")
  followers         Follow[]          @relation("Following")
  operatorLinks     OperatorAdmin[]
  busReviews        RideFeedback[]
  creatorProfile    CreatorProfile?   @relation("CreatorUser")

  @@index([role])
  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

enum EmailTokenType {
  VERIFY
  RESET
}

/// Single-use link tokens. Only the sha256 is stored, so a database leak
/// cannot be replayed as a verification or password-reset link.
model EmailToken {
  id         String         @id @default(uuid())
  userId     String
  type       EmailTokenType
  tokenHash  String         @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("email_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  /// All tokens rotated from one login share a familyId. Presenting an
  /// already-revoked token means it was stolen, so the whole family dies.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

// ------------------------- ROUTES, OPERATORS, QR -------------------------

model Route {
  id          String  @id @default(uuid())
  code        String  @unique          // e.g. KTM-PKR
  name        String                    // Kathmandu – Pokhara
  nameNe      String?
  startPlace  String
  endPlace    String
  distanceKm  Int?
  typicalHours Float?
  description String?
  createdAt   DateTime @default(now())

  vehicles        Vehicle[]
  qrCodes         QrCode[]
  articleLinks    ArticleRoute[]
  businessTargets BusinessRouteTarget[]
  adTargets       AdRouteTarget[]
  guides          RouteGuide[]
  creatorJourneys CreatorJourney[]
  rideFeedback    RideFeedback[]
  leads           BusinessLead[]

  @@map("routes")
}

/// Checked by a Bato admin before the company's buses and QR codes go public, so
/// nobody can register someone else's fleet and collect reviews against it.
enum OperatorVerification {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OperatorMemberRole {
  OWNER
  MANAGER
}

enum BusStatus {
  ACTIVE
  IN_MAINTENANCE
  OFF_ROAD
}

/// SEAT stickers open the magazine; BUS and COMPANY codes open the public profile.
enum QrKind {
  SEAT
  BUS
  COMPANY
}

/// A bus company, or an individual owner with one bus.
model Operator {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  contactPhone String?
  contactEmail String?
  address   String?
  /// Company registration or PAN number, checked during verification.
  registrationNo String?
  description String?
  isActive  Boolean  @default(true)
  verification     OperatorVerification @default(PENDING)
  verifiedAt       DateTime?
  verificationNote String?
  createdAt DateTime @default(now())

  vehicles      Vehicle[]
  qrCodes       QrCode[]
  admins        OperatorAdmin[]
  drivers       Driver[]
  notifications FleetNotification[]

  @@index([verification])
  @@map("operators")
}

/// Company membership. Access to every fleet record is decided here, never by User.role.
model OperatorAdmin {
  operatorId String
  userId     String
  role       OperatorMemberRole @default(OWNER)
  createdAt  DateTime @default(now())
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([operatorId, userId])
  @@index([userId])
  @@map("operator_admins")
}

model Vehicle {
  id         String  @id @default(uuid())
  operatorId String
  routeId    String?
  /// Registration number as written on the plate, e.g. "BA 2 KHA 3456".
  plateNo    String
  /// plateNo upper-cased without spaces or punctuation. Unique across Bato, so one
  /// physical bus can only ever belong to one company.
  plateKey   String  @unique
  label      String?
  seatCount  Int?
  make       String?
  model      String?
  year       Int?
  busType    String?
  colour     String?
  amenities  String[] @default([])
  photoUrl   String?
  status     BusStatus @default(ACTIVE)
  odometerKm Int     @default(0)
  serviceIntervalKm   Int @default(10000)
  serviceIntervalDays Int @default(90)
  /// Archived buses leave public search and their QR codes stop working.
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  operator     Operator       @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  route        Route?         @relation(fields: [routeId], references: [id])
  qrCodes      QrCode[]
  rideFeedback RideFeedback[]
  lostItems    LostItem[]
  maintenance  MaintenanceRecord[]
  incidents    BusIncident[]
  documents    BusDocument[]
  fuelLogs     FuelLog[]
  assignments  DriverAssignment[]
  notifications FleetNotification[]

  @@unique([operatorId, plateNo])
  @@index([operatorId, isActive])
  @@map("vehicles")
}

/// A physical sticker. shortCode is what appears in the URL: /r/{shortCode}
model QrCode {
  id         String  @id @default(uuid())
  shortCode  String  @unique
  operatorId String?
  vehicleId  String?
  routeId    String?
  seatNo     String?
  placement  String? // SEAT_BACK, WINDOW, POSTER
  kind       QrKind  @default(SEAT)
  isActive   Boolean @default(true)
  printedAt  DateTime?
  replacedAt DateTime?
  createdAt  DateTime @default(now())

  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route    Route?    @relation(fields: [routeId], references: [id])
  scans    ScanEvent[]
  reviews  RideFeedback[]

  @@index([routeId])
  @@index([vehicleId, kind, isActive])
  @@map("qr_codes")
}

model ScanEvent {
  id        String   @id @default(uuid())
  qrCodeId  String
  sessionId String
  ipHash    String?
  userAgent String?
  isFirstScan Boolean @default(true)
  scannedAt DateTime @default(now())

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, scannedAt])
  /// resolve() checks "has this device scanned before" on every single scan.
  /// Without this index that is a full table scan on the hottest path.
  @@index([sessionId])
  @@index([scannedAt])
  @@map("scan_events")
}

// ------------------------- MAGAZINE -------------------------

model Category {
  id       String  @id @default(uuid())
  slug     String  @unique
  name     String
  nameNe   String?
  colorHex String  @default("F4A024")
  icon     String?
  sortOrder Int    @default(0)

  articles Article[]

  @@map("categories")
}

model Issue {
  id          String        @id @default(uuid())
  number      Int           @unique
  title       String
  titleNe     String?
  strapline   String?
  coverImageUrl String?
  season      String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())

  articles Article[]

  @@map("issues")
}

model Article {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  subtitle     String?
  body         String        // markdown
  coverImageUrl String?
  audioUrl     String?       // pre-generated TTS, cached offline
  readMinutes  Int           @default(3)
  language     Language      @default(EN)
  status       ContentStatus @default(DRAFT)
  isSponsored  Boolean       @default(false)
  isFeatured   Boolean       @default(false)
  /// set when a community post is elevated into the magazine
  sourcePostId String?       @unique
  categoryId   String?
  issueId      String?
  authorId     String?
  sponsorBusinessId String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id])
  issue      Issue?    @relation(fields: [issueId], references: [id])
  author     User?     @relation("ArticleAuthor", fields: [authorId], references: [id])
  sourcePost Post?     @relation("ElevatedPost", fields: [sourcePostId], references: [id])
  sponsor    Business? @relation(fields: [sponsorBusinessId], references: [id])

  routeLinks   ArticleRoute[]
  destinations ArticleDestination[]

  @@index([status, publishedAt])
  @@map("articles")
}

/// Route-aware content: which corridors an article belongs to.
model ArticleRoute {
  articleId String
  routeId   String
  sortOrder Int    @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([articleId, routeId])
  @@map("article_routes")
}

model Destination {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  nameNe      String?
  district    String
  province    String?
  latitude    Float
  longitude   Float
  description String?
  heroImageUrl String?
  createdAt   DateTime @default(now())

  articles ArticleDestination[]
  posts    Post[]
  places   Place[]
  businesses Business[]
  creatorJourneys CreatorJourney[]

  @@map("destinations")
}

model ArticleDestination {
  articleId     String
  destinationId String
  article       Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([articleId, destinationId])
  @@map("article_destinations")
}

// ------------------------- USER-GENERATED CONTENT -------------------------

model Post {
  id            String           @id @default(uuid())
  authorId      String
  title         String
  body          String
  template      PostTemplate     @default(FREEFORM)
  coverImageUrl String?
  destinationId String?
  latitude      Float?
  longitude     Float?
  locationName  String?
  status        ContentStatus    @default(DRAFT)
  moderation    ModerationStatus @default(PENDING)
  moderationNote String?
  /// Client-generated id so an offline draft syncs exactly once.
  /// Kept separate from moderationNote, which moderators overwrite.
  clientDraftId String?
  /// true once an editor promotes it into a magazine issue
  isElevated    Boolean          @default(false)
  publishedAt   DateTime?
  /// honours User.publishDelayHours for solo-traveller safety
  visibleFrom   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id])
  photos      PostPhoto[]
  votes       PostVote[]
  elevatedTo  Article?     @relation("ElevatedPost")
  journeyEntries CreatorJourneyPost[]

  @@unique([authorId, clientDraftId])
  @@index([status, moderation, publishedAt])
  @@index([authorId])
  @@map("posts")
}

model PostPhoto {
  id        String  @id @default(uuid())
  postId    String
  url       String
  caption   String?
  latitude  Float?
  longitude Float?
  sortOrder Int     @default(0)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_photos")
}

/// One vote per traveller per post; value is +1 or -1. Kept apart from
/// Reaction so the magazine's LIKE/LOVE semantics stay unchanged.
model PostVote {
  userId    String
  postId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, value])
  @@map("post_votes")
}

model Comment {
  id         String           @id @default(uuid())
  userId     String
  targetType TargetType
  targetId   String
  parentId   String?
  body       String
  moderation ModerationStatus @default(APPROVED)
  createdAt  DateTime         @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentThread")

  @@index([targetType, targetId])
  @@map("comments")
}

model Reaction {
  id         String       @id @default(uuid())
  userId     String
  targetType TargetType
  targetId   String
  type       ReactionType @default(LIKE)
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reactions")
}

model Bookmark {
  id         String     @id @default(uuid())
  userId     String
  targetType TargetType
  targetId   String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@map("bookmarks")
}

// ------------------------- MAPS & PLACES -------------------------

model Place {
  id            String    @id @default(uuid())
  name          String
  nameNe        String?
  type          PlaceType
  latitude      Float
  longitude     Float
  altitudeM     Int?
  district      String?
  destinationId String?
  notes         String?
  isVerified    Boolean   @default(false)
  osmId         String?
  createdAt     DateTime  @default(now())

  destination   Destination?    @relation(fields: [destinationId], references: [id])
  itineraryStops ItineraryStop[]
  guideStops    RouteGuideStop[]

  @@index([type])
  @@map("places")
}

/// Downloadable offline map bundle metadata (MBTiles pack served from CDN).
model MapPack {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  region     String
  version    Int      @default(1)
  sizeBytes  BigInt
  downloadUrl String
  checksum   String?
  minLat     Float
  minLng     Float
  maxLat     Float
  maxLng     Float
  updatedAt  DateTime @updatedAt

  @@map("map_packs")
}

// ------------------------- ITINERARIES -------------------------

model Itinerary {
  id            String      @id @default(uuid())
  userId        String?
  title         String
  summary       String?
  dayCount      Int         @default(1)
  budgetStyle   BudgetStyle @default(STANDARD)
  estimatedCostNpr Int?
  isTemplate    Boolean     @default(false)
  isPublic      Boolean     @default(false)
  shareToken    String?     @unique
  sourceArticleId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  days ItineraryDay[]

  @@index([isTemplate])
  @@map("itineraries")
}

model ItineraryDay {
  id          String @id @default(uuid())
  itineraryId String
  dayNumber   Int
  title       String?
  notes       String?

  itinerary Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  stops     ItineraryStop[]

  @@unique([itineraryId, dayNumber])
  @@map("itinerary_days")
}

model ItineraryStop {
  id         String  @id @default(uuid())
  dayId      String
  sortOrder  Int     @default(0)
  name       String
  time       String?
  notes      String?
  costNpr    Int?
  placeId    String?
  businessId String?

  day      ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  place    Place?       @relation(fields: [placeId], references: [id])
  business Business?    @relation(fields: [businessId], references: [id])

  @@map("itinerary_stops")
}

model Permit {
  id          String  @id @default(uuid())
  code        String  @unique  // TIMS, ACAP, SNP
  name        String
  region      String
  costNprSaarc Int?
  costNprForeign Int?
  costNprNepali Int?
  whereToObtain String
  notes       String?

  @@map("permits")
}

// ------------------------- BUSINESS PLATFORM -------------------------

model Business {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  category    BusinessCategory
  description String?
  ownerId     String?
  destinationId String?
  district    String?
  address     String?
  latitude    Float?
  longitude   Float?
  phone       String?
  whatsapp    String?
  viber       String?
  website     String?
  priceRange  String?          // NPR 1500-4000
  amenities   String[]         @default([])
  tier        BusinessTier     @default(FREE)
  isActive    Boolean          @default(true)
  verifiedAt  DateTime?
  verifiedBy  String?
  verificationNote String?
  subscriptionEndsAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  owner        User?       @relation("BusinessOwner", fields: [ownerId], references: [id])
  destination  Destination? @relation(fields: [destinationId], references: [id])
  photos       BusinessPhoto[]
  routeTargets BusinessRouteTarget[]
  coupons      Coupon[]
  reviews      Review[]
  leads        BusinessLead[]
  sponsoredArticles Article[]
  itineraryStops    ItineraryStop[]
  guideStops        RouteGuideStop[]
  subscriptionEvents SubscriptionEvent[]
  advertisements     Advertisement[]

  @@index([category, tier])
  @@map("businesses")
}

model BusinessPhoto {
  id         String @id @default(uuid())
  businessId String
  url        String
  caption    String?
  sortOrder  Int    @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_photos")
}

/// Route-corridor targeting: show this business to readers on this route.
model BusinessRouteTarget {
  businessId String
  routeId    String
  priority   Int      @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([businessId, routeId])
  @@map("business_route_targets")
}

model Coupon {
  id             String   @id @default(uuid())
  businessId     String
  title          String
  description    String?
  discountLabel  String   // "10% off", "Free tea"
  validFrom      DateTime @default(now())
  validTo        DateTime
  maxRedemptions Int?
  perUserLimit   Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@map("coupons")
}

/// One row per issued code. This is the lead-attribution proof shown to businesses.
model CouponRedemption {
  id         String    @id @default(uuid())
  couponId   String
  userId     String?
  code       String    @unique
  issuedAt   DateTime  @default(now())
  redeemedAt DateTime?
  routeId    String?

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([couponId, redeemedAt])
  @@map("coupon_redemptions")
}

model Review {
  id           String           @id @default(uuid())
  businessId   String
  userId       String
  rating       Int
  body         String?
  /// verified reviews are tied to a redeemed coupon
  redemptionId String?
  moderation   ModerationStatus @default(PENDING)
  reply        String?
  repliedAt    DateTime?
  createdAt    DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("reviews")
}

model BusinessLead {
  id         String   @id @default(uuid())
  businessId String
  type       LeadType
  userId     String?
  routeId    String?
  sessionId  String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  route    Route?   @relation(fields: [routeId], references: [id])

  @@index([businessId, createdAt])
  @@map("business_leads")
}

/// Billing lifecycle audit. Separate from ModerationEntry because the
/// scheduler has no moderator to attribute an expiry to.
model SubscriptionEvent {
  id          String       @id @default(uuid())
  businessId  String
  fromTier    BusinessTier
  toTier      BusinessTier
  reason      String       // UPGRADED | RENEWED | EXPIRED | CANCELLED
  actorId     String?      // null when the nightly job did it
  note        String?
  createdAt   DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("subscription_events")
}

// ------------------------- MARKETING SLOTS -------------------------

enum AdPlacement {
  TOP_BANNER
  BETWEEN_STORIES
  ARTICLE_TOP
  ARTICLE_BOTTOM
  VLOG_FEED
  TRIP_PLANNER
  ROUTE_GUIDE
  MAP_SCREEN
  MORE_SCREEN
  BUS_PAGE
  CREATOR_PROFILE
  SEARCH_RESULTS
}

enum AdDurationUnit {
  DAY
  WEEK
  MONTH
}

enum AdLinkType {
  EXTERNAL
  OVERVIEW
}

/// Newspaper-style paid placement. Status is derived, never stored:
/// paused (isActive false), scheduled (before startsAt), expired (after
/// endsAt), otherwise active — so an expired ad cannot show even if no job ran.
model Advertisement {
  id               String         @id @default(uuid())
  title            String
  advertiserName   String
  tagline          String?
  imageUrl         String
  placement        AdPlacement
  durationUnit     AdDurationUnit
  durationCount    Int
  startsAt         DateTime
  endsAt           DateTime
  linkType         AdLinkType
  externalUrl      String?
  overviewTitle    String?
  overviewBody     String?
  overviewImageUrl String?
  businessId       String?
  isActive         Boolean        @default(true)
  impressions      Int            @default(0)
  clicks           Int            @default(0)
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  /// No targets means "show on every route". With targets, the ad only appears to
  /// travellers on those corridors, so a Pokhara hotel isn't sold to a Chitwan bus.
  routeTargets     AdRouteTarget[]

  business  Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdBy User      @relation("AdCreator", fields: [createdById], references: [id])

  @@index([placement, isActive, startsAt, endsAt])
  @@map("advertisements")
}

// ------------------------- CREATORS -------------------------

enum CreatorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

/// A traveller an admin has given creator access: a public profile built around
/// their adventures, with the context Instagram leaves out — the route, the days,
/// what it cost and what they carried.
model CreatorProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  handle       String        @unique
  displayName  String
  headline     String?
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  homeBase     String?
  languages    String[]      @default([])
  specialities String[]      @default([])
  websiteUrl   String?
  instagram    String?
  youtube      String?
  status       CreatorStatus @default(PENDING)
  isFeatured   Boolean       @default(false)
  approvedAt   DateTime?
  approvedById String?
  /// Why an application was refused or an account suspended; shown to the creator.
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User             @relation("CreatorUser", fields: [userId], references: [id], onDelete: Cascade)
  journeys CreatorJourney[]

  @@index([status, isFeatured])
  @@map("creator_profiles")
}

/// One trip told in order: the posts that make it up, plus the route, the length,
/// the real cost and the gear that worked.
model CreatorJourney {
  id            String        @id @default(uuid())
  creatorId     String
  slug          String
  title         String
  summary       String?
  coverImageUrl String?
  routeId       String?
  destinationId String?
  startedOn     DateTime?
  dayCount      Int?
  transportNpr  Int?
  stayNpr       Int?
  foodNpr       Int?
  permitsNpr    Int?
  otherNpr      Int?
  gear          String[]      @default([])
  tips          String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  creator     CreatorProfile       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  route       Route?               @relation(fields: [routeId], references: [id], onDelete: SetNull)
  destination Destination?         @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  entries     CreatorJourneyPost[]

  @@unique([creatorId, slug])
  @@index([status, publishedAt])
  @@map("creator_journeys")
}

/// Posts belong to the traveller, not the journey, so adding one to a journey is a
/// link: the post keeps its votes, comments and moderation state.
model CreatorJourneyPost {
  journeyId String
  postId    String
  dayNumber Int?
  note      String?
  sortOrder Int    @default(0)

  journey CreatorJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  post    Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([journeyId, postId])
  @@index([postId])
  @@map("creator_journey_posts")
}

// ------------------------- ROUTE GUIDES -------------------------

enum GuideStopKind {
  LANDMARK
  VIEWPOINT
  FOOD
  HOTEL
  REST_STOP
  FUEL
  ATM
  HOSPITAL
  TEMPLE
  SHOPPING
  ACTIVITY
  OTHER
}

/// A guide written for one direction of travel, or for both. Stops are authored in
/// the route's forward order; reading a BOTH guide backwards reverses them.
enum GuideDirection {
  BOTH
  FORWARD
  REVERSE
}

/// What an editor builds for a journey, e.g. Kathmandu → Pokhara: the landmarks,
/// places to eat and places to stay along that corridor, in travel order.
model RouteGuide {
  id            String         @id @default(uuid())
  routeId       String
  direction     GuideDirection @default(BOTH)
  title         String
  summary       String?
  coverImageUrl String?
  status        ContentStatus  @default(DRAFT)
  sortOrder     Int            @default(0)
  createdById   String?
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  route Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stops RouteGuideStop[]

  @@index([routeId, status])
  @@map("route_guides")
}

model RouteGuideStop {
  id                  String        @id @default(uuid())
  guideId             String
  kind                GuideStopKind @default(LANDMARK)
  name                String
  description         String?
  imageUrl            String?
  latitude            Float?
  longitude           Float?
  /// How far along the corridor it is, which is also how stops are ordered for the reader.
  distanceFromStartKm Int?
  minutesFromStart    Int?
  priceFromNpr        Int?
  openingHours        String?
  contactPhone        String?
  tip                 String?
  placeId             String?
  businessId          String?
  isHighlight         Boolean       @default(false)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  guide    RouteGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  place    Place?     @relation(fields: [placeId], references: [id], onDelete: SetNull)
  business Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([guideId, sortOrder])
  @@map("route_guide_stops")
}

model AdRouteTarget {
  adId    String
  routeId String
  ad      Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)
  route   Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([adId, routeId])
  @@index([routeId])
  @@map("ad_route_targets")
}

// ------------------------- OPERATOR FEEDBACK -------------------------

/// A passenger's review of one bus. The owner sees the words and the scores, never
/// who wrote them: a passenger will not rate a driver honestly with their name attached.
model RideFeedback {
  id          String   @id @default(uuid())
  vehicleId   String?
  routeId     String?
  /// Device session for signed-out reviewers; used only to stop repeat reviews.
  sessionId   String?
  userId      String?
  ipHash      String?
  /// Set when the review came from scanning the sticker on that bus.
  qrCodeId    String?
  overall     Int
  cleanliness Int?
  driving     Int?
  punctuality Int?
  staff       Int?
  comment     String?
  suggestion  String?
  tripDate    DateTime?
  moderation  ModerationStatus @default(APPROVED)
  ownerReply     String?
  ownerRepliedAt DateTime?
  createdAt   DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route   Route?   @relation(fields: [routeId], references: [id])
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  qrCode  QrCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([vehicleId, createdAt])
  @@index([vehicleId, moderation, createdAt])
  @@map("ride_feedback")
}

model LostItem {
  id          String   @id @default(uuid())
  vehicleId   String?
  seatNo      String?
  description String
  contactPhone String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("lost_items")
}

// ------------------------- SAFETY -------------------------

model EmergencyNumber {
  id       String  @id @default(uuid())
  district String?
  label    String
  phone    String
  category String  // POLICE, AMBULANCE, HOSPITAL, RESCUE, EMBASSY, TOURIST_POLICE
  isNational Boolean @default(false)

  @@index([district])
  @@map("emergency_numbers")
}

model EmergencyContact {
  id     String @id @default(uuid())
  userId String
  name   String
  phone  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model SosEvent {
  id        String   @id @default(uuid())
  userId    String
  latitude  Float?
  longitude Float?
  message   String?
  channel   String   @default("DATA") // DATA | SMS
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sos_events")
}

// ------------------------- TRUST & SAFETY -------------------------

model Report {
  id         String       @id @default(uuid())
  reporterId String?
  /// Anonymous reporters are told apart by device session for de-duplication,
  /// and counted towards auto-hide by a salted hash of their network address,
  /// so one person with many browser sessions still counts once.
  sessionId  String?
  ipHash     String?
  targetType TargetType
  targetId   String
  reason     ReportReason
  detail     String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  reporter User? @relation("Reporter", fields: [reporterId], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId, status])
  @@map("reports")
}

// ------------------------- FLEET: MAINTENANCE, DOCUMENTS, DRIVERS, FUEL -------------------------

enum MaintenanceKind {
  ROUTINE_SERVICE
  REPAIR
  PARTS_REPLACEMENT
  INSPECTION
  TYRES
  BODYWORK
  OTHER
}

model MaintenanceRecord {
  id          String          @id @default(uuid())
  vehicleId   String
  kind        MaintenanceKind @default(ROUTINE_SERVICE)
  servicedAt  DateTime
  odometerKm  Int
  title       String
  note        String?
  workshop    String?
  costNpr     Int?
  partsReplaced String[]      @default([])
  photos      String[]        @default([])
  /// Optional overrides for the next service; otherwise the bus's intervals apply.
  nextDueDate DateTime?
  nextDueKm   Int?
  createdById String?
  createdAt   DateTime        @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, servicedAt])
  @@map("maintenance_records")
}

enum IncidentKind {
  BREAKDOWN
  ACCIDENT
  FLAT_TYRE
  ENGINE
  BRAKES
  ELECTRICAL
  OTHER
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

/// Breakdowns and emergency repairs on the road.
model BusIncident {
  id          String           @id @default(uuid())
  vehicleId   String
  kind        IncidentKind     @default(BREAKDOWN)
  severity    IncidentSeverity @default(MAJOR)
  status      IncidentStatus   @default(OPEN)
  occurredAt  DateTime
  location    String?
  odometerKm  Int?
  description String
  photos      String[]         @default([])
  driverId    String?
  resolvedAt  DateTime?
  resolutionNote String?
  repairCostNpr  Int?
  reportedById String?
  createdAt   DateTime         @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([vehicleId, status])
  @@map("bus_incidents")
}

enum BusDocumentType {
  BLUEBOOK
  ROUTE_PERMIT
  INSURANCE
  POLLUTION_CERTIFICATE
  FITNESS_CERTIFICATE
  TAX_CLEARANCE
  OTHER
}

model BusDocument {
  id        String          @id @default(uuid())
  vehicleId String
  type      BusDocumentType
  number    String?
  issuer    String?
  issuedAt  DateTime?
  expiresAt DateTime?
  photoUrl  String?
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([expiresAt])
  @@map("bus_documents")
}

enum DriverRole {
  DRIVER
  CONDUCTOR
  HELPER
}

/// Crew belong to the company, so a driver can move between its buses with their history intact.
model Driver {
  id               String     @id @default(uuid())
  operatorId       String
  name             String
  phone            String
  role             DriverRole @default(DRIVER)
  licenceNumber    String?
  licenceExpiresAt DateTime?
  photoUrl         String?
  note             String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())

  operator    Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  assignments DriverAssignment[]
  incidents   BusIncident[]

  @@index([operatorId, isActive])
  @@map("drivers")
}

/// Who was on which bus and when, so a complaint can be matched to the crew on duty.
model DriverAssignment {
  id        String    @id @default(uuid())
  driverId  String
  vehicleId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, endedAt])
  @@index([driverId, endedAt])
  @@map("driver_assignments")
}

model FuelLog {
  id         String   @id @default(uuid())
  vehicleId  String
  filledAt   DateTime
  odometerKm Int
  litres     Float
  costNpr    Int
  /// Mileage is only measured between two full-tank fills; partial fills carry forward.
  fullTank   Boolean  @default(true)
  station    String?
  note       String?
  createdAt  DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, filledAt])
  @@map("fuel_logs")
}

/// In-app reminders and updates for a company. dedupeKey stops the nightly job
/// from raising the same reminder twice.
model FleetNotification {
  id         String    @id @default(uuid())
  operatorId String
  vehicleId  String?
  kind       String
  title      String
  body       String
  dedupeKey  String    @unique
  readAt     DateTime?
  emailedAt  DateTime?
  createdAt  DateTime  @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([operatorId, readAt, createdAt])
  @@map("fleet_notifications")
}

/// Append-only moderation audit trail.
model ModerationEntry {
  id          String        @id @default(uuid())
  moderatorId String
  targetType  TargetType
  targetId    String
  action      ModerationAct
  note        String?
  createdAt   DateTime      @default(now())

  moderator User @relation("Moderator", fields: [moderatorId], references: [id])

  @@index([targetType, targetId])
  @@map("moderation_entries")
}
