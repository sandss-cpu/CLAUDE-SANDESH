// =====================================================================
//  QR TRAVEL MAGAZINE & TOURISM PLATFORM  —  Prisma schema
//  PostgreSQL. Geospatial columns use plain lat/lng doubles plus an
//  optional PostGIS geography column added via raw migration SQL.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- ENUMS -------------------------

enum Role {
  READER
  CONTRIBUTOR
  BUSINESS_OWNER
  OPERATOR_ADMIN
  MODERATOR
  EDITOR
  ADMIN
}

enum Language {
  NE
  EN
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum TargetType {
  ARTICLE
  POST
  COMMENT
  BUSINESS
  REVIEW
  USER
  AD
  BUS_REVIEW
  OPERATOR
}

enum ReactionType {
  LIKE
  LOVE
  HELPFUL
  WOW
}

enum BusinessCategory {
  HOTEL
  HOMESTAY
  LODGE
  RESTAURANT
  CAFE
  TREKKING_AGENCY
  ADVENTURE
  PARAGLIDING
  RENTAL
  GUIDE
  HANDICRAFT
  TOUR_OPERATOR
  TRANSPORT
}

enum BusinessTier {
  FREE
  VERIFIED
  FEATURED
  PREMIUM
}

enum LeadType {
  PROFILE_VIEW
  CALL
  WHATSAPP
  VIBER
  DIRECTIONS
  WEBSITE
  ENQUIRY
  COUPON_VIEW
}

enum PlaceType {
  BUS_STOP
  TOILET
  ATM
  PHARMACY
  HOSPITAL
  POLICE
  FUEL
  DRINKING_WATER
  VIEWPOINT
  TEAHOUSE
  TEMPLE
  MONASTERY
  MUSEUM
  TREK_START
  CAMPSITE
  OTHER
}

enum BudgetStyle {
  BACKPACKER
  STANDARD
  COMFORT
}

enum PostTemplate {
  FREEFORM
  MY_TREK
  A_DAY_IN
  WHERE_I_ATE
  GETTING_THERE
  WHAT_IT_COST
}

enum ReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  ILLEGAL
  SEXUAL_CONTENT
  COPYRIGHT
  UNSAFE_BUSINESS
  /// A bus company says a review names the wrong driver or conductor; a moderator re-attributes it.
  WRONG_CREW
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ModerationAct {
  APPROVE
  REJECT
  HIDE
  DELETE
  WARN_USER
  SUSPEND_USER
  UNSUSPEND_USER
  CHANGE_ROLE
  RESET_MFA
  CREATE
  UPDATE
  PAUSE
  RESUME
  /// A bus review moved to another trip's crew, or to "crew unknown".
  REASSIGN_CREW
}

// ------------------------- IDENTITY -------------------------

model User {
  id                String    @id @default(uuid())
  phone             String?   @unique
  email             String?   @unique
  name              String
  avatarUrl         String?
  bio               String?
  homeDistrict      String?
  language          Language  @default(NE)
  role              Role      @default(READER)
  isPhoneVerified   Boolean   @default(false)
  /// argon2id. Null for phone-only accounts.
  passwordHash      String?
  /// Email sign-in is refused until the owner has clicked the emailed link.
  emailVerifiedAt   DateTime?
  isSuspended       Boolean   @default(false)
  suspendedUntil    DateTime?
  /// TOTP second factor. Mandatory for privileged roles — an SMS code alone
  /// is not an acceptable gate on platform administration (SIM-swap risk).
  /// Encrypted at rest (common/crypto/field-crypto.ts).
  totpSecret        String?
  totpConfirmedAt   DateTime?
  /// "Sign out everywhere": access tokens issued before this are refused.
  sessionsValidFrom DateTime?
  // privacy
  hideExactLocation Boolean   @default(true)
  publishDelayHours Int       @default(0) // solo-traveller safety: delay geo publish
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  articles          Article[]          @relation("ArticleAuthor")
  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  postVotes         PostVote[]
  bookmarks         Bookmark[]
  itineraries       Itinerary[]
  reviews           Review[]
  redemptions       CouponRedemption[]
  refreshTokens     RefreshToken[]
  emailTokens       EmailToken[]
  ownedBusinesses   Business[]         @relation("BusinessOwner")
  adsCreated        Advertisement[]    @relation("AdCreator")
  reportsMade       Report[]           @relation("Reporter")
  moderationActions ModerationEntry[]  @relation("Moderator")
  emergencyContacts EmergencyContact[]
  sosEvents         SosEvent[]
  following         Follow[]           @relation("Follower")
  followers         Follow[]           @relation("Following")
  operatorLinks     OperatorAdmin[]
  busReviews        RideFeedback[]
  creatorProfile    CreatorProfile?    @relation("CreatorUser")
  placementsMade    ContentPlacement[] @relation("PlacementAuthor")
  appraisalsWritten DriverAppraisal[]  @relation("Appraiser")
  recoveryCodes     RecoveryCode[]
  knownDevices      KnownDevice[]
  verificationDocs  VerificationDocument[] @relation("DocUploader")

  @@index([role])
  @@map("users")
}

/// One-time codes for when the authenticator is lost. Only a hash is kept.
model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Failed sign-ins, per account and per address hash: progressive delay, then a lock.
model LoginGuard {
  key            String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime  @default(now())
  lastFailureAt  DateTime  @default(now())
  lockedUntil    DateTime?

  @@map("login_guards")
}

/// Browsers an account has signed in from, so a new one can be reported by email.
model KnownDevice {
  id          String   @id @default(uuid())
  userId      String
  /// Keyed hash of the browser and system family ("Chrome on Android"), never the raw user agent.
  deviceHash  String
  label       String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@map("known_devices")
}

enum VerificationDocKind {
  PAN
  COMPANY_REGISTRATION
  BLUEBOOK
  ROUTE_PERMIT
  BUSINESS_LICENCE
  OTHER
}

/// Proof a company or business is who it says, in private storage, seen only by its
/// owners and Batoma's staff through short-lived signed links.
model VerificationDocument {
  id           String              @id @default(uuid())
  operatorId   String?
  businessId   String?
  kind         VerificationDocKind
  storageKey   String              @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime            @default(now())

  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("DocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([operatorId])
  @@index([businessId])
  @@map("verification_documents")
}

/// Scans older than 13 months, kept only as daily counts per code.
model ScanDaily {
  day        DateTime @db.Date
  qrCodeId   String
  scans      Int
  firstScans Int
  sessions   Int

  @@id([day, qrCodeId])
  @@map("scan_daily")
}

/// Website events older than 13 months, kept only as daily counts.
model SiteEventDaily {
  id         BigInt        @id @default(autoincrement())
  day        DateTime      @db.Date
  type       SiteEventType
  target     String?
  businessId String?
  adId       String?
  articleId  String?
  count      Int

  @@index([businessId, day])
  @@index([adId, day])
  @@map("site_event_daily")
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

enum EmailTokenType {
  VERIFY
  RESET
}

/// Single-use link tokens. Only the sha256 is stored, so a database leak
/// cannot be replayed as a verification or password-reset link.
model EmailToken {
  id         String         @id @default(uuid())
  userId     String
  type       EmailTokenType
  tokenHash  String         @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("email_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  /// All tokens rotated from one login share a familyId. Presenting an
  /// already-revoked token means it was stolen, so the whole family dies.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

// ------------------------- ROUTES, OPERATORS, QR -------------------------

model Route {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. KTM-PKR
  name         String // Kathmandu – Pokhara
  nameNe       String?
  startPlace   String
  endPlace     String
  distanceKm   Int?
  typicalHours Float?
  description  String?
  createdAt    DateTime @default(now())

  vehicles        Vehicle[]
  qrCodes         QrCode[]
  placements      ContentPlacement[]
  notices         RouteNotice[]
  trips           Trip[]
  businessTargets BusinessRouteTarget[]
  adTargets       AdRouteTarget[]
  guides          RouteGuide[]
  creatorJourneys CreatorJourney[]
  rideFeedback    RideFeedback[]
  leads           BusinessLead[]

  @@map("routes")
}

/// Checked by a Bato admin before the company's buses and QR codes go public, so
/// nobody can register someone else's fleet and collect reviews against it.
enum OperatorVerification {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

/// CREW can only start and end trips (conductors on the duty screen); OWNER and MANAGER as before.
enum OperatorMemberRole {
  OWNER
  MANAGER
  CREW
}

enum BusStatus {
  ACTIVE
  IN_MAINTENANCE
  OFF_ROAD
}

/// BUS: the one permanent code on each bus; it opens that bus's magazine (/b/<code>), with
/// rating second. SEAT: optional seat stickers, kept for seat-level statistics. COMPANY: the
/// company's public profile.
enum QrKind {
  SEAT
  BUS
  COMPANY
}

/// A bus company, or an individual owner with one bus.
model Operator {
  id                String               @id @default(uuid())
  name              String
  slug              String               @unique
  logoUrl           String?
  /// Encrypted at rest (common/crypto/field-crypto.ts); searched through contactPhoneIdx.
  contactPhone      String?
  /// Keyed hash of the normalised contact phone, for exact-match search.
  contactPhoneIdx   String?
  contactEmail      String?
  address           String?
  /// Company registration or PAN number, checked during verification.
  registrationNo    String?
  description       String?
  isActive          Boolean              @default(true)
  verification      OperatorVerification @default(PENDING)
  verifiedAt        DateTime?
  verificationNote  String?
  /// Income records stay off until an owner with an authenticator turns them on.
  financeEnabled    Boolean              @default(false)
  financeEnabledAt  DateTime?
  /// Managers can always enter income; they see totals and reports only if this is on.
  managersSeeTotals Boolean              @default(false)
  createdAt         DateTime             @default(now())

  vehicles      Vehicle[]
  qrCodes       QrCode[]
  admins        OperatorAdmin[]
  drivers       Driver[]
  notifications FleetNotification[]
  placements    ContentPlacement[]
  trips         Trip[]
  appraisals    DriverAppraisal[]
  incomeSources IncomeSource[]
  incomeEntries IncomeEntry[]
  incomeImports IncomeImport[]
  documents     VerificationDocument[]

  @@index([verification])
  @@index([contactPhoneIdx])
  @@map("operators")
}

/// Company membership. Access to every fleet record is decided here, never by User.role.
model OperatorAdmin {
  operatorId String
  userId     String
  role       OperatorMemberRole @default(OWNER)
  createdAt  DateTime           @default(now())
  operator   Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([operatorId, userId])
  @@index([userId])
  @@map("operator_admins")
}

model Vehicle {
  id                  String    @id @default(uuid())
  operatorId          String
  routeId             String?
  /// Registration number as written on the plate, e.g. "BA 2 KHA 3456".
  plateNo             String
  /// plateNo upper-cased without spaces or punctuation. Unique across Bato, so one
  /// physical bus can only ever belong to one company.
  plateKey            String    @unique
  label               String?
  seatCount           Int?
  make                String?
  model               String?
  year                Int?
  busType             String?
  colour              String?
  amenities           String[]  @default([])
  photoUrl            String?
  status              BusStatus @default(ACTIVE)
  odometerKm          Int       @default(0)
  serviceIntervalKm   Int       @default(10000)
  serviceIntervalDays Int       @default(90)
  /// Archived buses leave public search and their QR codes stop working.
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  operator      Operator            @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  route         Route?              @relation(fields: [routeId], references: [id])
  qrCodes       QrCode[]
  rideFeedback  RideFeedback[]
  lostItems     LostItem[]
  maintenance   MaintenanceRecord[]
  incidents     BusIncident[]
  documents     BusDocument[]
  fuelLogs      FuelLog[]
  assignments   DriverAssignment[]
  notifications FleetNotification[]
  placements    ContentPlacement[]
  trips         Trip[]
  incomeEntries IncomeEntry[]

  @@unique([operatorId, plateNo])
  @@index([operatorId, isActive])
  @@map("vehicles")
}

/// A physical sticker. shortCode is what appears in the URL: /r/{shortCode}
model QrCode {
  id         String    @id @default(uuid())
  shortCode  String    @unique
  operatorId String?
  vehicleId  String?
  routeId    String?
  seatNo     String?
  placement  String? // SEAT_BACK, WINDOW, POSTER
  kind       QrKind    @default(SEAT)
  isActive   Boolean   @default(true)
  printedAt  DateTime?
  replacedAt DateTime?
  createdAt  DateTime  @default(now())

  operator Operator?      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route    Route?         @relation(fields: [routeId], references: [id])
  scans    ScanEvent[]
  reviews  RideFeedback[]
  prints   QrPrint[]

  @@index([routeId])
  @@index([vehicleId, kind, isActive])
  @@map("qr_codes")
}

/// What was printed or downloaded, and by whom: a sticker that keeps being reprinted is
/// worth a look, and the owner can see when the stickers in their buses were made.
model QrPrint {
  id          String   @id @default(uuid())
  qrCodeId    String
  operatorId  String
  /// PDF_A6, PDF_SEAT, SHEET_A6 (four to an A4 sheet), PNG or SVG.
  format      String
  printedById String?
  createdAt   DateTime @default(now())

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
  @@index([operatorId, createdAt])
  @@map("qr_prints")
}

model ScanEvent {
  id          String   @id @default(uuid())
  qrCodeId    String
  sessionId   String
  ipHash      String?
  userAgent   String?
  isFirstScan Boolean  @default(true)
  scannedAt   DateTime @default(now())

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, scannedAt])
  /// resolve() checks "has this device scanned before" on every single scan.
  /// Without this index that is a full table scan on the hottest path.
  @@index([sessionId])
  @@index([scannedAt])
  @@map("scan_events")
}

// ------------------------- MAGAZINE -------------------------

model Category {
  id        String  @id @default(uuid())
  slug      String  @unique
  name      String
  nameNe    String?
  colorHex  String  @default("F4A024")
  icon      String?
  sortOrder Int     @default(0)

  articles Article[]
  sponsors Advertisement[]

  @@map("categories")
}

model Issue {
  id            String        @id @default(uuid())
  number        Int           @unique
  title         String
  titleNe       String?
  strapline     String?
  coverImageUrl String?
  season        String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())

  articles Article[]

  @@map("issues")
}

model Article {
  id                String        @id @default(uuid())
  slug              String        @unique
  title             String
  subtitle          String?
  /// One line for cards: 160 characters at most (checked in SQL). Required to publish.
  summary           String?       @db.VarChar(160)
  /// "In brief": one to three points shown at the top of the article. Required to publish.
  keyPoints         String[]      @default([])
  body              String // markdown
  coverImageUrl     String?
  audioUrl          String? // pre-generated TTS, cached offline
  readMinutes       Int           @default(3)
  language          Language      @default(EN)
  status            ContentStatus @default(DRAFT)
  isSponsored       Boolean       @default(false)
  isFeatured        Boolean       @default(false)
  /// set when a community post is elevated into the magazine
  sourcePostId      String?       @unique
  categoryId        String?
  issueId           String?
  authorId          String?
  sponsorBusinessId String?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id])
  issue      Issue?    @relation(fields: [issueId], references: [id])
  author     User?     @relation("ArticleAuthor", fields: [authorId], references: [id])
  sourcePost Post?     @relation("ElevatedPost", fields: [sourcePostId], references: [id])
  sponsor    Business? @relation(fields: [sponsorBusinessId], references: [id])

  placements   ContentPlacement[]
  destinations ArticleDestination[]

  @@index([status, publishedAt])
  @@map("articles")
}

// ------------------------- CONTENT PROGRAMMING -------------------------

/// How widely a placement applies. A bus sees, in order: its own placements, its
/// company's, its route's for its direction, its route's for both directions, then
/// the DEFAULT list and the current issue. See programming/content-for.ts.
enum PlacementScope {
  DEFAULT
  ROUTE
  OPERATOR
  VEHICLE
}

/// One article placed in front of travellers: on every bus, on a route, on one
/// company's buses or on one bus. Which columns are set is checked in SQL
/// (placement_target); one article sits in a slot once (placement_slot, an
/// expression index Prisma cannot describe).
model ContentPlacement {
  id          String         @id @default(uuid())
  articleId   String
  scope       PlacementScope
  /// Required for ROUTE. On OPERATOR and VEHICLE it narrows the placement to that
  /// road, so a story chosen for one journey stops when the bus moves to another.
  routeId     String?
  operatorId  String?
  vehicleId   String?
  direction   GuideDirection @default(BOTH)
  position    Int            @default(0)
  /// The lead story for its slot. Pinning one unpins the rest of the slot.
  isPinned    Boolean        @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  /// 0 = Sunday … 6 = Saturday, in Asia/Kathmandu. Empty means every day. For a window
  /// that runs past midnight, the day is the one the window opened on.
  daysOfWeek  Int[]          @default([])
  /// "HH:MM" in Asia/Kathmandu. timeFrom later than timeTo runs past midnight (night buses).
  timeFrom    String?
  timeTo      String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  route     Route?    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  operator  Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("PlacementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([scope, routeId, direction])
  @@index([operatorId])
  @@index([vehicleId])
  @@index([articleId])
  @@map("content_placements")
}

enum NoticeSeverity {
  INFO
  WARNING
  DANGER
}

/// A road alert shown at the top of the reader for one route and direction:
/// a landslide, a closure, festival traffic.
model RouteNotice {
  id          String         @id @default(uuid())
  routeId     String
  direction   GuideDirection @default(BOTH)
  severity    NoticeSeverity @default(INFO)
  title       String
  titleNe     String?
  body        String?
  bodyNe      String?
  startsAt    DateTime       @default(now())
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, startsAt])
  @@map("route_notices")
}

/// Append-only record of admin, finance and security changes: who did what, to which
/// row, and what it looked like before and after. No foreign keys, so the history
/// outlives what it describes. routeId and operatorId are copied in so a route's or a
/// company's history can be read without joining through rows that may be gone.
model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  before     Json?
  after      Json?
  routeId    String?
  operatorId String?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([routeId, createdAt])
  @@index([operatorId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model Destination {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  nameNe       String?
  district     String
  province     String?
  latitude     Float
  longitude    Float
  description  String?
  heroImageUrl String?
  createdAt    DateTime @default(now())

  articles        ArticleDestination[]
  posts           Post[]
  places          Place[]
  businesses      Business[]
  creatorJourneys CreatorJourney[]
  guides          RouteGuide[]
  sponsors        Advertisement[]

  @@map("destinations")
}

model ArticleDestination {
  articleId     String
  destinationId String
  article       Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([articleId, destinationId])
  @@map("article_destinations")
}

// ------------------------- USER-GENERATED CONTENT -------------------------

model Post {
  id             String           @id @default(uuid())
  authorId       String
  title          String
  body           String
  template       PostTemplate     @default(FREEFORM)
  coverImageUrl  String?
  destinationId  String?
  latitude       Float?
  longitude      Float?
  locationName   String?
  status         ContentStatus    @default(DRAFT)
  moderation     ModerationStatus @default(PENDING)
  moderationNote String?
  /// Client-generated id so an offline draft syncs exactly once.
  /// Kept separate from moderationNote, which moderators overwrite.
  clientDraftId  String?
  /// true once an editor promotes it into a magazine issue
  isElevated     Boolean          @default(false)
  publishedAt    DateTime?
  /// honours User.publishDelayHours for solo-traveller safety
  visibleFrom    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  author         User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  destination    Destination?         @relation(fields: [destinationId], references: [id])
  photos         PostPhoto[]
  votes          PostVote[]
  elevatedTo     Article?             @relation("ElevatedPost")
  journeyEntries CreatorJourneyPost[]

  @@unique([authorId, clientDraftId])
  @@index([status, moderation, publishedAt])
  @@index([authorId])
  @@map("posts")
}

model PostPhoto {
  id        String  @id @default(uuid())
  postId    String
  url       String
  caption   String?
  latitude  Float?
  longitude Float?
  sortOrder Int     @default(0)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_photos")
}

/// One vote per traveller per post; value is +1 or -1. Kept apart from
/// Reaction so the magazine's LIKE/LOVE semantics stay unchanged.
model PostVote {
  userId    String
  postId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, value])
  @@map("post_votes")
}

model Comment {
  id         String           @id @default(uuid())
  userId     String
  targetType TargetType
  targetId   String
  parentId   String?
  body       String
  moderation ModerationStatus @default(APPROVED)
  createdAt  DateTime         @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentThread")

  @@index([targetType, targetId])
  @@map("comments")
}

model Reaction {
  id         String       @id @default(uuid())
  userId     String
  targetType TargetType
  targetId   String
  type       ReactionType @default(LIKE)
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reactions")
}

model Bookmark {
  id         String     @id @default(uuid())
  userId     String
  targetType TargetType
  targetId   String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@map("bookmarks")
}

// ------------------------- MAPS & PLACES -------------------------

model Place {
  id            String    @id @default(uuid())
  name          String
  nameNe        String?
  type          PlaceType
  latitude      Float
  longitude     Float
  altitudeM     Int?
  district      String?
  destinationId String?
  notes         String?
  isVerified    Boolean   @default(false)
  osmId         String?
  createdAt     DateTime  @default(now())

  destination    Destination?     @relation(fields: [destinationId], references: [id])
  itineraryStops ItineraryStop[]
  guideStops     RouteGuideStop[]

  @@index([type])
  @@map("places")
}

/// Downloadable offline map bundle metadata (MBTiles pack served from CDN).
model MapPack {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  region      String
  version     Int      @default(1)
  sizeBytes   BigInt
  downloadUrl String
  checksum    String?
  minLat      Float
  minLng      Float
  maxLat      Float
  maxLng      Float
  updatedAt   DateTime @updatedAt

  @@map("map_packs")
}

// ------------------------- ITINERARIES -------------------------

model Itinerary {
  id               String      @id @default(uuid())
  userId           String?
  title            String
  summary          String?
  dayCount         Int         @default(1)
  budgetStyle      BudgetStyle @default(STANDARD)
  estimatedCostNpr Int?
  isTemplate       Boolean     @default(false)
  isPublic         Boolean     @default(false)
  shareToken       String?     @unique
  sourceArticleId  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  days ItineraryDay[]

  @@index([isTemplate])
  @@map("itineraries")
}

model ItineraryDay {
  id          String  @id @default(uuid())
  itineraryId String
  dayNumber   Int
  title       String?
  notes       String?

  itinerary Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  stops     ItineraryStop[]

  @@unique([itineraryId, dayNumber])
  @@map("itinerary_days")
}

model ItineraryStop {
  id         String  @id @default(uuid())
  dayId      String
  sortOrder  Int     @default(0)
  name       String
  time       String?
  notes      String?
  costNpr    Int?
  placeId    String?
  businessId String?

  day      ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  place    Place?       @relation(fields: [placeId], references: [id])
  business Business?    @relation(fields: [businessId], references: [id])

  @@map("itinerary_stops")
}

model Permit {
  id             String  @id @default(uuid())
  code           String  @unique // TIMS, ACAP, SNP
  name           String
  region         String
  costNprSaarc   Int?
  costNprForeign Int?
  costNprNepali  Int?
  whereToObtain  String
  notes          String?

  @@map("permits")
}

// ------------------------- BUSINESS PLATFORM -------------------------

model Business {
  id                 String           @id @default(uuid())
  slug               String           @unique
  name               String
  category           BusinessCategory
  description        String?
  ownerId            String?
  destinationId      String?
  district           String?
  address            String?
  latitude           Float?
  longitude          Float?
  phone              String?
  whatsapp           String?
  viber              String?
  website            String?
  priceRange         String? // NPR 1500-4000
  amenities          String[]         @default([])
  tier               BusinessTier     @default(FREE)
  isActive           Boolean          @default(true)
  verifiedAt         DateTime?
  verifiedBy         String?
  verificationNote   String?
  subscriptionEndsAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  owner              User?                 @relation("BusinessOwner", fields: [ownerId], references: [id])
  destination        Destination?          @relation(fields: [destinationId], references: [id])
  photos             BusinessPhoto[]
  routeTargets       BusinessRouteTarget[]
  coupons            Coupon[]
  reviews            Review[]
  leads              BusinessLead[]
  sponsoredArticles  Article[]
  itineraryStops     ItineraryStop[]
  guideStops         RouteGuideStop[]
  subscriptionEvents SubscriptionEvent[]
  advertisements     Advertisement[]
  packages           PartnerPackage[]
  documents          VerificationDocument[]

  @@index([category, tier])
  @@map("businesses")
}

model BusinessPhoto {
  id         String   @id @default(uuid())
  businessId String
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_photos")
}

/// Route-corridor targeting: show this business to readers on this route.
model BusinessRouteTarget {
  businessId String
  routeId    String
  priority   Int      @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([businessId, routeId])
  @@map("business_route_targets")
}

model Coupon {
  id             String   @id @default(uuid())
  businessId     String
  title          String
  description    String?
  discountLabel  String // "10% off", "Free tea"
  validFrom      DateTime @default(now())
  validTo        DateTime
  maxRedemptions Int?
  perUserLimit   Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@map("coupons")
}

/// One row per issued code. This is the lead-attribution proof shown to businesses.
model CouponRedemption {
  id         String    @id @default(uuid())
  couponId   String
  userId     String?
  code       String    @unique
  issuedAt   DateTime  @default(now())
  redeemedAt DateTime?
  routeId    String?

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([couponId, redeemedAt])
  @@map("coupon_redemptions")
}

model Review {
  id           String           @id @default(uuid())
  businessId   String
  userId       String
  rating       Int
  body         String?
  /// verified reviews are tied to a redeemed coupon
  redemptionId String?
  moderation   ModerationStatus @default(PENDING)
  reply        String?
  repliedAt    DateTime?
  createdAt    DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("reviews")
}

enum LeadChannel {
  APP
  SITE
}

model BusinessLead {
  id         String      @id @default(uuid())
  businessId String
  type       LeadType
  userId     String?
  routeId    String?
  sessionId  String?
  /// An enquiry: who wrote, how to reach them and what they asked. The contact is
  /// personal data, kept only for the partner who was asked.
  name       String?
  contact    String?
  message    String?
  channel    LeadChannel @default(APP)
  createdAt  DateTime    @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  route    Route?   @relation(fields: [routeId], references: [id])

  @@index([businessId, createdAt])
  @@map("business_leads")
}

/// Billing lifecycle audit. Separate from ModerationEntry because the
/// scheduler has no moderator to attribute an expiry to.
model SubscriptionEvent {
  id         String       @id @default(uuid())
  businessId String
  fromTier   BusinessTier
  toTier     BusinessTier
  reason     String // UPGRADED | RENEWED | EXPIRED | CANCELLED
  actorId    String? // null when the nightly job did it
  note       String?
  createdAt  DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("subscription_events")
}

// ------------------------- MARKETING SLOTS -------------------------

enum AdPlacement {
  TOP_BANNER
  BETWEEN_STORIES
  ARTICLE_TOP
  ARTICLE_BOTTOM
  VLOG_FEED
  TRIP_PLANNER
  ROUTE_GUIDE
  MAP_SCREEN
  MORE_SCREEN
  BUS_PAGE
  CREATOR_PROFILE
  SEARCH_RESULTS
  /// The public website (bato-site). Sold as partner packages; each is labelled where it shows.
  WEB_HOME_HERO
  WEB_SECTION_SPONSOR
  WEB_SPONSORED_ARTICLE
  WEB_DESTINATION_SPONSOR
  WEB_DEALS
  WEB_NEWSLETTER
}

enum AdDurationUnit {
  DAY
  WEEK
  MONTH
}

enum AdLinkType {
  EXTERNAL
  OVERVIEW
}

/// Newspaper-style paid placement. Status is derived, never stored:
/// paused (isActive false), scheduled (before startsAt), expired (after
/// endsAt), otherwise active — so an expired ad cannot show even if no job ran.
model Advertisement {
  id                  String          @id @default(uuid())
  title               String
  advertiserName      String
  tagline             String?
  imageUrl            String
  placement           AdPlacement
  durationUnit        AdDurationUnit
  durationCount       Int
  startsAt            DateTime
  endsAt              DateTime
  linkType            AdLinkType
  externalUrl         String?
  overviewTitle       String?
  overviewBody        String?
  overviewImageUrl    String?
  businessId          String?
  isActive            Boolean         @default(true)
  impressions         Int             @default(0)
  clicks              Int             @default(0)
  /// WEB_SECTION_SPONSOR: the magazine section it sponsors. WEB_DESTINATION_SPONSOR: the place.
  targetCategoryId    String?
  targetDestinationId String?
  createdById         String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  /// No targets means "show on every route". With targets, the ad only appears to
  /// travellers on those corridors, so a Pokhara hotel isn't sold to a Chitwan bus.
  routeTargets        AdRouteTarget[]

  business          Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdBy         User         @relation("AdCreator", fields: [createdById], references: [id])
  targetCategory    Category?    @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  targetDestination Destination? @relation(fields: [targetDestinationId], references: [id], onDelete: SetNull)

  @@index([placement, isActive, startsAt, endsAt])
  @@map("advertisements")
}

// ------------------------- CREATORS -------------------------

enum CreatorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

/// A traveller an admin has given creator access: a public profile built around
/// their adventures, with the context Instagram leaves out — the route, the days,
/// what it cost and what they carried.
model CreatorProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  handle       String        @unique
  displayName  String
  headline     String?
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  homeBase     String?
  languages    String[]      @default([])
  specialities String[]      @default([])
  websiteUrl   String?
  instagram    String?
  youtube      String?
  status       CreatorStatus @default(PENDING)
  isFeatured   Boolean       @default(false)
  approvedAt   DateTime?
  approvedById String?
  /// Why an application was refused or an account suspended; shown to the creator.
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User             @relation("CreatorUser", fields: [userId], references: [id], onDelete: Cascade)
  journeys CreatorJourney[]

  @@index([status, isFeatured])
  @@map("creator_profiles")
}

/// One trip told in order: the posts that make it up, plus the route, the length,
/// the real cost and the gear that worked.
model CreatorJourney {
  id            String        @id @default(uuid())
  creatorId     String
  slug          String
  title         String
  summary       String?
  coverImageUrl String?
  routeId       String?
  destinationId String?
  startedOn     DateTime?
  dayCount      Int?
  transportNpr  Int?
  stayNpr       Int?
  foodNpr       Int?
  permitsNpr    Int?
  otherNpr      Int?
  gear          String[]      @default([])
  tips          String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  creator     CreatorProfile       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  route       Route?               @relation(fields: [routeId], references: [id], onDelete: SetNull)
  destination Destination?         @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  entries     CreatorJourneyPost[]

  @@unique([creatorId, slug])
  @@index([status, publishedAt])
  @@map("creator_journeys")
}

/// Posts belong to the traveller, not the journey, so adding one to a journey is a
/// link: the post keeps its votes, comments and moderation state.
model CreatorJourneyPost {
  journeyId String
  postId    String
  dayNumber Int?
  note      String?
  sortOrder Int     @default(0)

  journey CreatorJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  post    Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([journeyId, postId])
  @@index([postId])
  @@map("creator_journey_posts")
}

// ------------------------- ROUTE GUIDES -------------------------

enum GuideStopKind {
  LANDMARK
  VIEWPOINT
  FOOD
  HOTEL
  REST_STOP
  FUEL
  ATM
  HOSPITAL
  TEMPLE
  SHOPPING
  ACTIVITY
  OTHER
}

/// A guide written for one direction of travel, or for both. Stops are authored in
/// the route's forward order; reading a BOTH guide backwards reverses them.
enum GuideDirection {
  BOTH
  FORWARD
  REVERSE
}

/// ROUTE guides follow a corridor in travel order; DESTINATION guides are the
/// day-by-day plan for a place, so their stops carry day numbers.
enum GuideKind {
  ROUTE
  DESTINATION
}

/// What an editor builds for a journey, e.g. Kathmandu → Pokhara: the landmarks,
/// places to eat and places to stay along that corridor, in travel order.
model RouteGuide {
  id            String         @id @default(uuid())
  /// For the public site's clean URLs: /trips/<slug>.
  slug          String         @unique
  kind          GuideKind      @default(ROUTE)
  /// Set for ROUTE guides; null for DESTINATION ones, and the other way round.
  routeId       String?
  destinationId String?
  direction     GuideDirection @default(BOTH)
  title         String
  summary       String?
  coverImageUrl String?
  /// Day-by-day plans say how long they run; route guides leave it null.
  dayCount      Int?
  status        ContentStatus  @default(DRAFT)
  sortOrder     Int            @default(0)
  createdById   String?
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  route       Route?           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  destination Destination?     @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  stops       RouteGuideStop[]

  @@index([routeId, status])
  @@index([destinationId, status])
  @@map("route_guides")
}

model RouteGuideStop {
  id                  String        @id @default(uuid())
  guideId             String
  kind                GuideStopKind @default(LANDMARK)
  name                String
  description         String?
  imageUrl            String?
  latitude            Float?
  longitude           Float?
  /// Which day of a destination itinerary this stop belongs to; null on route guides.
  dayNumber           Int?
  /// How far along the corridor it is, which is also how stops are ordered for the reader.
  distanceFromStartKm Int?
  minutesFromStart    Int?
  priceFromNpr        Int?
  openingHours        String?
  contactPhone        String?
  tip                 String?
  placeId             String?
  businessId          String?
  isHighlight         Boolean       @default(false)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  guide    RouteGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  place    Place?     @relation(fields: [placeId], references: [id], onDelete: SetNull)
  business Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([guideId, sortOrder])
  @@map("route_guide_stops")
}

model AdRouteTarget {
  adId    String
  routeId String
  ad      Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)
  route   Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([adId, routeId])
  @@index([routeId])
  @@map("ad_route_targets")
}

// ------------------------- OPERATOR FEEDBACK -------------------------

/// A passenger's review of one bus. The owner sees the words and the scores, never
/// who wrote them: a passenger will not rate a driver honestly with their name attached.
model RideFeedback {
  id             String           @id @default(uuid())
  vehicleId      String?
  routeId        String?
  /// Device session for signed-out reviewers; used only to stop repeat reviews.
  sessionId      String?
  userId         String?
  ipHash         String?
  /// Set when the review came from scanning the sticker on that bus.
  qrCodeId       String?
  /// Set by the server when the review is written: the trip running at the moment of the
  /// scan, else the crew assigned then, else nobody ("crew unknown"). Never sent by the client.
  tripId         String?
  driverId       String?
  conductorId    String?
  overall        Int
  cleanliness    Int?
  driving        Int?
  punctuality    Int?
  staff          Int?
  comment        String?
  suggestion     String?
  tripDate       DateTime?
  moderation     ModerationStatus @default(APPROVED)
  ownerReply     String?
  ownerRepliedAt DateTime?
  createdAt      DateTime         @default(now())

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route     Route?   @relation(fields: [routeId], references: [id])
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  qrCode    QrCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  driver    Driver?  @relation("ReviewDriver", fields: [driverId], references: [id], onDelete: SetNull)
  conductor Driver?  @relation("ReviewConductor", fields: [conductorId], references: [id], onDelete: SetNull)

  @@index([vehicleId, createdAt])
  @@index([vehicleId, moderation, createdAt])
  @@index([driverId, createdAt])
  @@index([tripId])
  @@map("ride_feedback")
}

model LostItem {
  id           String   @id @default(uuid())
  vehicleId    String?
  seatNo       String?
  description  String
  contactPhone String
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("lost_items")
}

// ------------------------- SAFETY -------------------------

model EmergencyNumber {
  id         String  @id @default(uuid())
  district   String?
  label      String
  phone      String
  category   String // POLICE, AMBULANCE, HOSPITAL, RESCUE, EMBASSY, TOURIST_POLICE
  isNational Boolean @default(false)

  @@index([district])
  @@map("emergency_numbers")
}

model EmergencyContact {
  id     String @id @default(uuid())
  userId String
  name   String
  phone  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model SosEvent {
  id        String   @id @default(uuid())
  userId    String
  latitude  Float?
  longitude Float?
  message   String?
  channel   String   @default("DATA") // DATA | SMS
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sos_events")
}

// ------------------------- TRUST & SAFETY -------------------------

model Report {
  id         String       @id @default(uuid())
  reporterId String?
  /// Anonymous reporters are told apart by device session for de-duplication,
  /// and counted towards auto-hide by a salted hash of their network address,
  /// so one person with many browser sessions still counts once.
  sessionId  String?
  ipHash     String?
  targetType TargetType
  targetId   String
  reason     ReportReason
  detail     String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  reporter User? @relation("Reporter", fields: [reporterId], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId, status])
  @@map("reports")
}

// ------------------------- FLEET: MAINTENANCE, DOCUMENTS, DRIVERS, FUEL -------------------------

enum MaintenanceKind {
  ROUTINE_SERVICE
  REPAIR
  PARTS_REPLACEMENT
  INSPECTION
  TYRES
  BODYWORK
  OTHER
}

model MaintenanceRecord {
  id            String          @id @default(uuid())
  vehicleId     String
  kind          MaintenanceKind @default(ROUTINE_SERVICE)
  servicedAt    DateTime
  odometerKm    Int
  title         String
  note          String?
  workshop      String?
  costNpr       Int?
  partsReplaced String[]        @default([])
  photos        String[]        @default([])
  /// Optional overrides for the next service; otherwise the bus's intervals apply.
  nextDueDate   DateTime?
  nextDueKm     Int?
  createdById   String?
  createdAt     DateTime        @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, servicedAt])
  @@map("maintenance_records")
}

enum IncidentKind {
  BREAKDOWN
  ACCIDENT
  FLAT_TYRE
  ENGINE
  BRAKES
  ELECTRICAL
  OTHER
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

/// Breakdowns and emergency repairs on the road.
model BusIncident {
  id             String           @id @default(uuid())
  vehicleId      String
  kind           IncidentKind     @default(BREAKDOWN)
  severity       IncidentSeverity @default(MAJOR)
  status         IncidentStatus   @default(OPEN)
  occurredAt     DateTime
  location       String?
  odometerKm     Int?
  description    String
  photos         String[]         @default([])
  driverId       String?
  resolvedAt     DateTime?
  resolutionNote String?
  repairCostNpr  Int?
  reportedById   String?
  createdAt      DateTime         @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([vehicleId, status])
  @@map("bus_incidents")
}

enum BusDocumentType {
  BLUEBOOK
  ROUTE_PERMIT
  INSURANCE
  POLLUTION_CERTIFICATE
  FITNESS_CERTIFICATE
  TAX_CLEARANCE
  OTHER
}

model BusDocument {
  id        String          @id @default(uuid())
  vehicleId String
  type      BusDocumentType
  number    String?
  issuer    String?
  issuedAt  DateTime?
  expiresAt DateTime?
  photoUrl  String?
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([expiresAt])
  @@map("bus_documents")
}

enum DriverRole {
  DRIVER
  CONDUCTOR
  HELPER
}

/// Crew belong to the company, so a driver can move between its buses with their history intact.
model Driver {
  id               String     @id @default(uuid())
  operatorId       String
  name             String
  phone            String
  role             DriverRole @default(DRIVER)
  licenceNumber    String?
  licenceExpiresAt DateTime?
  photoUrl         String?
  note             String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())

  operator           Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  assignments        DriverAssignment[]
  incidents          BusIncident[]
  tripsDriven        Trip[]             @relation("TripDriver")
  tripsConducted     Trip[]             @relation("TripConductor")
  tripsHelped        Trip[]             @relation("TripHelper")
  reviewsAsDriver    RideFeedback[]     @relation("ReviewDriver")
  reviewsAsConductor RideFeedback[]     @relation("ReviewConductor")
  appraisals         DriverAppraisal[]

  @@index([operatorId, isActive])
  @@map("drivers")
}

/// Who was on which bus and when, so a complaint can be matched to the crew on duty.
model DriverAssignment {
  id        String    @id @default(uuid())
  driverId  String
  vehicleId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, endedAt])
  @@index([driverId, endedAt])
  @@map("driver_assignments")
}

enum TripStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// How the crew got onto the trip: chosen by hand, or taken from who was assigned to the bus.
enum TripSource {
  MANUAL
  ASSIGNMENT_DEFAULT
}

/// One run of one bus in one direction, and who crewed it. It is what lets a passenger's
/// review be put against the driver who was actually at the wheel, and what tells the
/// reader which way the bus is going.
model Trip {
  id              String         @id @default(uuid())
  /// Copied from the bus, so access checks and company reports need no join.
  operatorId      String
  vehicleId       String
  routeId         String?
  /// FORWARD or REVERSE (checked in SQL): a run always goes one way.
  direction       GuideDirection
  departAt        DateTime
  arriveAt        DateTime?
  driverId        String?
  conductorId     String?
  helperId        String?
  source          TripSource     @default(MANUAL)
  status          TripStatus     @default(IN_PROGRESS)
  startOdometerKm Int?
  endOdometerKm   Int?
  createdById     String?
  /// Trips lock 48 hours after departure; an owner can reopen one, with a reason, for a day.
  unlockedUntil   DateTime?
  unlockReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  operator  Operator       @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route     Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  driver    Driver?        @relation("TripDriver", fields: [driverId], references: [id], onDelete: SetNull)
  conductor Driver?        @relation("TripConductor", fields: [conductorId], references: [id], onDelete: SetNull)
  helper    Driver?        @relation("TripHelper", fields: [helperId], references: [id], onDelete: SetNull)
  reviews   RideFeedback[]
  income    IncomeEntry[]

  @@index([vehicleId, departAt])
  @@index([vehicleId, status])
  @@index([operatorId, departAt])
  @@index([driverId, departAt])
  @@map("trips")
}

enum AppraisalOutcome {
  NONE
  COMMENDATION
  BONUS
  TRAINING
  WARNING
}

enum AppraisalStatus {
  DRAFT
  FINAL
}

/// A company's appraisal of one crew member over a period. Scores are 1 to 5 (checked in
/// SQL). A draft starts with scores suggested from the scorecard (kept in `suggested`, so
/// the screen can show what the data said beside what the owner chose). A final appraisal
/// can no longer be changed, only acknowledged once it has been discussed with the driver.
model DriverAppraisal {
  id               String           @id @default(uuid())
  operatorId       String
  driverId         String
  periodStart      DateTime         @db.Date
  periodEnd        DateTime         @db.Date
  drivingScore     Int?
  punctualityScore Int?
  conductScore     Int?
  safetyScore      Int?
  vehicleCareScore Int?
  attendanceScore  Int?
  /// The scorecard's suggestion for each score and what it was based on, when the draft was made.
  suggested        Json?
  comments         String?
  strengths        String?
  goals            String?
  outcome          AppraisalOutcome @default(NONE)
  appraiserId      String?
  status           AppraisalStatus  @default(DRAFT)
  finalisedAt      DateTime?
  acknowledgedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  operator  Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  appraiser User?    @relation("Appraiser", fields: [appraiserId], references: [id], onDelete: SetNull)

  @@index([operatorId, createdAt])
  @@index([driverId, periodEnd])
  @@map("driver_appraisals")
}

// ------------------------- INCOME RECORDS -------------------------

enum IncomeSourceKind {
  CASH
  PORTAL
  CARGO
  HIRE
  OTHER
}

/// Where a company's money comes from: counter cash, Bussewa, eSewa and so on. Eight
/// defaults are created when finance is turned on; owners add their own. A portal's
/// saved import column mapping lives here.
model IncomeSource {
  id            String           @id @default(uuid())
  operatorId    String
  name          String
  kind          IncomeSourceKind @default(OTHER)
  isActive      Boolean          @default(true)
  position      Int              @default(0)
  importMapping Json?
  createdAt     DateTime         @default(now())

  operator Operator       @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  entries  IncomeEntry[]
  imports  IncomeImport[]

  @@unique([operatorId, name])
  @@map("income_sources")
}

/// What one bus earned from one source on one day (or one trip). Money is integer paisa;
/// net = gross - fees is checked in SQL. A settlement reference can be used once per
/// source among live entries: a partial unique index (raw SQL, Prisma cannot express it),
/// so an undone import can be imported again. Deleting is soft; entries lock 7 days after
/// they are made.
model IncomeEntry {
  id            String    @id @default(uuid())
  operatorId    String
  vehicleId     String
  tripId        String?
  date          DateTime  @db.Date
  sourceId      String
  ticketsSold   Int       @default(0)
  seatsSold     Int?
  grossPaisa    Int
  feesPaisa     Int       @default(0)
  netPaisa      Int
  reference     String?
  note          String?
  /// A photo of the statement, in private storage.
  attachmentKey String?
  importId      String?
  createdById   String?
  updatedById   String?
  lockedAt      DateTime
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  operator Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  vehicle  Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip     Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  source   IncomeSource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  import   IncomeImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([operatorId, date])
  @@index([vehicleId, date])
  @@index([importId])
  @@map("income_entries")
}

/// One CSV or XLSX import: what was in the file and what was saved. Undo within 24 hours
/// soft-deletes the entries it made.
model IncomeImport {
  id          String    @id @default(uuid())
  operatorId  String
  sourceId    String
  filename    String
  format      String
  rows        Int
  created     Int
  duplicates  Int
  invalid     Int
  mapping     Json
  createdById String?
  undoneAt    DateTime?
  undoneById  String?
  createdAt   DateTime  @default(now())

  operator Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  source   IncomeSource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  entries  IncomeEntry[]

  @@index([operatorId, createdAt])
  @@map("income_imports")
}

// ------------------------- PUBLIC SITE -------------------------

enum PackageKind {
  HOME_HERO
  SECTION_SPONSOR
  SPONSORED_ARTICLE
  DESTINATION_SPONSOR
  DEALS
  NEWSLETTER
  LISTING
}

enum PackageStatus {
  PROPOSED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

/// What a partner bought, for how long and at what price: the admin's record of each deal.
/// Prices are whatever was agreed (integer paisa); the placements themselves are ads.
model PartnerPackage {
  id          String        @id @default(uuid())
  businessId  String
  kind        PackageKind
  startsAt    DateTime
  endsAt      DateTime
  pricePaisa  Int?
  status      PackageStatus @default(PROPOSED)
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
  @@index([status, endsAt])
  @@map("partner_packages")
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

/// Newsletter sign-ups, double opt-in: nothing is sent until the address is confirmed.
model NewsletterSubscriber {
  id               String           @id @default(uuid())
  email            String           @unique
  status           SubscriberStatus @default(PENDING)
  confirmTokenHash String?
  unsubscribeToken String           @unique
  source           String?
  ipHash           String?
  createdAt        DateTime         @default(now())
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?

  @@map("newsletter_subscribers")
}

enum SiteEventType {
  PAGE_VIEW
  IMPRESSION
  CLICK
}

/// The public site's own analytics, append-only: no cookies, no third party. A visit is
/// told apart only by a salted hash of address, browser and a 30-minute window, so a
/// /go/ click counts once per visit (a partial unique index) and no person is traceable.
model SiteEvent {
  id           BigInt        @id @default(autoincrement())
  type         SiteEventType
  path         String
  target       String?
  businessId   String?
  adId         String?
  articleId    String?
  sessionHash  String
  referrerHost String?
  createdAt    DateTime      @default(now())

  @@index([type, createdAt])
  @@index([businessId, type, createdAt])
  @@index([adId, type, createdAt])
  @@map("site_events")
}

enum EnquiryKind {
  ADVERTISE
  CONTACT
}

enum EnquiryStatus {
  NEW
  HANDLED
}

/// "Advertise with Batoma" and contact messages: the admin inbox.
model SiteEnquiry {
  id           String        @id @default(uuid())
  kind         EnquiryKind
  name         String
  contact      String
  organisation String?
  message      String
  status       EnquiryStatus @default(NEW)
  handledById  String?
  handledAt    DateTime?
  ipHash       String?
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
  @@map("site_enquiries")
}

model FuelLog {
  id         String   @id @default(uuid())
  vehicleId  String
  filledAt   DateTime
  odometerKm Int
  litres     Float
  costNpr    Int
  /// Mileage is only measured between two full-tank fills; partial fills carry forward.
  fullTank   Boolean  @default(true)
  station    String?
  note       String?
  createdAt  DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, filledAt])
  @@map("fuel_logs")
}

/// In-app reminders and updates for a company. dedupeKey stops the nightly job
/// from raising the same reminder twice.
model FleetNotification {
  id         String    @id @default(uuid())
  operatorId String
  vehicleId  String?
  kind       String
  title      String
  body       String
  dedupeKey  String    @unique
  readAt     DateTime?
  emailedAt  DateTime?
  createdAt  DateTime  @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([operatorId, readAt, createdAt])
  @@map("fleet_notifications")
}

/// One row, id "app": how Batoma looks to everyone. Set by an admin in the control
/// panel and read by every page, so the whole platform changes together.
model PlatformSetting {
  id              String   @id @default("app")
  themePalette    String   @default("prayer-flag")
  themeBackground String   @default("none")
  appName         String   @default("Batoma")
  tagline         String?
  updatedById     String?
  updatedAt       DateTime @updatedAt

  @@map("platform_settings")
}

/// Append-only moderation audit trail.
model ModerationEntry {
  id          String        @id @default(uuid())
  moderatorId String
  targetType  TargetType
  targetId    String
  action      ModerationAct
  note        String?
  createdAt   DateTime      @default(now())

  moderator User @relation("Moderator", fields: [moderatorId], references: [id])

  @@index([targetType, targetId])
  @@map("moderation_entries")
}
