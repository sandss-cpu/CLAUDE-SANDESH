# ---- Core ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# The URL a phone can reach this API on. Used to build absolute offline-pack
# URLs — relative paths would resolve against the web origin and cache 404s.
API_PUBLIC_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173

# Comma-separated. Required in production; wildcards are rejected because
# credentials are enabled. Defaults to localhost only in development.
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
DATABASE_URL="postgresql://travel:travel@localhost:5432/travel_magazine?schema=public"

# ---- Auth ----
# Generate with: openssl rand -base64 48
# The app refuses to start if this is left as the placeholder or is under 32 chars.
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=60
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Required in production — the app will not start without it. Left blank in
# development the login code is returned in the API response instead of sent,
# which is why production refuses to boot in that state.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=TRAVELMAG

# ---- Media ----
MEDIA_BASE_URL=http://localhost:3000/static
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ---- Deep links (Module 9) ----
IOS_APP_ID=id0000000000
ANDROID_PACKAGE=np.travelmagazine.app
APP_STORE_URL=https://apps.apple.com/app/id0000000000
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=np.travelmagazine.app
MIN_SUPPORTED_APP_BUILD=1
