# ---- Core ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# The URL a phone can reach this API on. Used to build absolute offline-pack
# URLs — relative paths would resolve against the web origin and cache 404s.
API_PUBLIC_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173
# The permanent short link printed on every bus sticker: <SHORT_LINK_BASE>/b/<code>.
# Set it to the public domain before printing a single sticker, and never change it
# afterwards. Left empty, PUBLIC_WEB_URL is used.
SHORT_LINK_BASE=

# Comma-separated. Required in production; wildcards are rejected because
# credentials are enabled. Defaults to localhost only in development.
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API. 0 locally; 1 on Render.
# Left at 0 behind a proxy, every visitor shares the proxy's address, so rate
# limits and report counting treat them all as one person.
TRUST_PROXY=0

# ---- Database ----
DATABASE_URL="postgresql://travel:travel@localhost:5432/travel_magazine?schema=public"

# ---- Auth ----
# Generate with: openssl rand -base64 48
# The app refuses to start if this is left as the placeholder or is under 32 chars.
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=60
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ---- Email sign-in ----
# Required in production. Left blank in development, verification and reset
# links are returned in the API response as `devLink` instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Batoma <no-reply@example.com>"

# ---- Phone sign-in ----
# Defaults to on in development and off in production. When on in production,
# the SMS gateway below is mandatory.
PHONE_LOGIN_ENABLED=
# Left blank in development the login code is returned in the API response
# instead of sent, which is why production refuses to boot in that state.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=TRAVELMAG

# ---- Media ----
MEDIA_BASE_URL=http://localhost:3000/static
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ---- Deep links (Module 9) ----
# Leave the store URLs empty until the native apps are published: the reader only
# offers an install banner for a store that is configured, so a placeholder here
# would send travellers to a store page that does not exist.
IOS_APP_ID=
ANDROID_PACKAGE=
APP_STORE_URL=
PLAY_STORE_URL=
MIN_SUPPORTED_APP_BUILD=1

# ---- private files (statement photos) ----
# disk: files under PRIVATE_UPLOAD_DIR, never served statically, reached through signed
# links on this API. s3: a private S3-compatible bucket (Cloudflare R2 works), presigned links.
STORAGE_DRIVER=disk
PRIVATE_UPLOAD_DIR=./private-uploads
# Required in production: at least 32 random characters, different from JWT_SECRET.
SIGNED_URL_SECRET=
# For STORAGE_DRIVER=s3 (R2: https://<account id>.r2.cloudflarestorage.com, region auto)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- public website (bato-site) ----
# Where the site lives (newsletter links, purge calls) and the secret it shares with this
# API: the site posts forms with it, and this API signs cache purges with it.
SITE_URL=
SITE_API_KEY=
# Advertising and contact enquiries are emailed here too (they are always in the control panel).
ADMIN_INBOX=
# The site's read-only database role (npm run db:site-role sets its password).
SITE_DB_PASSWORD=
